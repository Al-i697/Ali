# ───────────────────────────────────────────────────────────────
# سجلي — إعدادات التشغيل. انسخ هذا الملف إلى .env وعدّل ما يلزم.
# كل القيم اختيارية؛ الافتراضيات مناسبة للتشغيل المحلي.
# ───────────────────────────────────────────────────────────────

NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# مجلد البيانات: قاعدة البيانات + النسخ الاحتياطية (احفظه على قرص دائم!)
DATA_DIR=./data
# DATABASE_FILE=./data/sijilli.sqlite
# BACKUP_DIR=./data/backups

# النسخ الاحتياطي التلقائي: كل كم ساعة (0 = تعطيل) وعدد النسخ المحتفظ بها
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# تشفير النسخ الاحتياطية (AES-256-GCM). اتركه فارغًا لعدم التشفير. احفظ العبارة في مكان آمن:
# بدونها لا يمكن استعادة النسخ المشفّرة.
# BACKUP_PASSPHRASE=

# العنوان العام للموقع عند النشر خلف HTTPS (يُستخدم للتحقق من Origin وملفات تعريف الارتباط الآمنة)
# APP_URL=https://sijilli.example.om
# true عند التشغيل خلف وكيل عكسي (Nginx/Caddy) ليقرأ عنوان IP الحقيقي
TRUST_PROXY=false
# auto: آمن تلقائيًا إذا بدأ APP_URL بـ https
COOKIE_SECURE=auto

# توليد PDF (Chromium). اتركه فارغًا ليبحث النظام عنه تلقائيًا.
# CHROMIUM_PATH=/usr/bin/chromium
# true داخل الحاويات (Docker) حيث لا يتوفر sandbox
PDF_NO_SANDBOX=false

LOG_LEVEL=info
# حد الطلبات العام لكل عنوان IP في الدقيقة (ارفعه إن ظهر كل المستخدمين بعنوان واحد خلف وكيل/NAT)
# RATE_LIMIT_PER_MINUTE=600
# المنطقة الزمنية للتواريخ (الأسبوع الدراسي والحصص)
TZ_NAME=Asia/Muscat

# ── المساعد الذكي (اختياري ومعطّل افتراضيًا) ──
# لا يظهر للمعلمين إلا بعد ضبط المزوّد هنا **و**موافقة المدير من الإعدادات ← «المساعد الذكي».
# المزوّد يستلم نصًا يكتبه المعلم (عنوان درس/أهداف/ملاحظات) ولا يصله أي بيانات طلاب. انظر docs/AI-EXTENSION.md
# تحقّق قبل التفعيل:  npm run cli -- ai-check
AI_PROVIDER=none
# ANTHROPIC_API_KEY=sk-ant-...        # سرّ: لا تضعه في المستودع
# AI_MODEL=claude-opus-5-5            # نموذج أصغر أرخص وأسرع (claude-sonnet-5-5 / claude-haiku-5-5) خيارك بعد التجربة
# AI_EFFORT=low                       # low | medium | high
# AI_BASE_URL=                        # بوابة/وكيل مؤسسي بدل الخدمة الرسمية
# AI_TIMEOUT_MS=90000                 # مهلة المحاولة الواحدة (قد تُعاد مرة)؛ مهلة الوكيل العكسي يجب أن تفوق ضعفها
# AI_DAILY_LIMIT=30                   # طلبات ناجحة لكل معلم خلال 24 ساعة
# AI_RATE_PER_MINUTE=6                # لكل معلم في الدقيقة
# AI_MAX_CONCURRENCY=3                # طلبات متزامنة للخادم كله
